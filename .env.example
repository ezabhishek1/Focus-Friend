# ==============================================================================
# Focus Friend - Environment Configuration Template
# Copy this file to '.env' and adjust values for your local environment:
#     cp .env.example .env
# ==============================================================================

# Server Identity & Network Binding
APP_NAME="Focus Friend"
APP_ENV="development"
HOST="127.0.0.1"
PORT=8501
LOG_LEVEL="INFO"

# Local Ollama AI Daemon Integration (100% Local Inference)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
DEFAULT_MODEL="phi3:mini"
INFERENCE_TIMEOUT_SECONDS=15
ENABLE_FALLBACK_ENGINE=true

# Security & Cross-Origin Resource Sharing (CORS)
ENABLE_CORS=true
CORS_ORIGINS=["*"]
